              link_arm_l0:
                {}
              link_arm_l1:
                {}
              link_arm_l2:
                {}
              link_arm_l3:
                {}
              link_gripper_finger_left:
                {}
              link_gripper_finger_right:
                {}
              link_head_pan:
                {}
              link_head_tilt:
                {}
              link_left_wheel:
                {}
              link_lift:
                {}
